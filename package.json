{
  "name": "app-lanche",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @app-lanche/api test",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "db:up": "docker compose up -d db",
    "app:up": "docker compose --profile app up -d --build --wait",
    "app:down": "docker compose --profile app down",
    "app:otp": "docker compose exec -T db psql -U postgres app_lanche -tAc \"SELECT data->>'code' FROM outbox_events WHERE type = 'auth.otp_requested' ORDER BY occurred_at DESC LIMIT 1\"",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed-dev.ts",
    "db:types": "pnpm --filter @app-lanche/api db:types",
    "n8n:build": "node n8n/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
