{
  "name": "app-lanche",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @app-lanche/api test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx db/migrate.ts",
    "db:types": "pnpm --filter @app-lanche/api db:types"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
