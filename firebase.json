{
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "app-lanche-api", "region": "southamerica-east1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
