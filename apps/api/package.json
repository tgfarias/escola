{
  "name": "@app-lanche/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "cli:create-school": "tsx src/cli/createSchool.ts",
    "cli:efi-setup": "tsx src/cli/efiSetup.ts",
    "db:types": "kysely-codegen --dialect postgres --camel-case --date-parser string --type-mapping '{\"int8\":\"number\"}' --out-file src/db/types.ts"
  },
  "dependencies": {
    "@app-lanche/contracts": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "testcontainers": "^12.2.1",
    "tsup": "^9.0.0"
  }
}
